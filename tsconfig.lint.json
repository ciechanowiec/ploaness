{
  // The solution file compiles the published packages, whose tsconfigs include `src` alone. The specs
  // were therefore in no project at all, so a type-aware lint had nothing to read them with and the
  // compiler never checked them. This project exists to give both the whole tree.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "vitest.config.mts",
    "vitest.setup.ts",
    // The programs that IMPLEMENT a check: the fixture mutations, the asset-body staging helper, and
    // the two package build scripts. Node strips their types where it runs them, which type-checks
    // nothing, so they are named here to give the compiler and the type-aware lint pass something to
    // read. The standard makes a check this repository implements into source code of it.
    "it/lib/*.ts",
    "scripts/lib/*.ts",
    "packages/*/build.ts"
  ]
}
