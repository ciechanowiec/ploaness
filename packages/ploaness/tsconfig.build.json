// The build of this package, kept apart from `tsconfig.json` for the reason `packages/config` is: that
// name belongs to the configuration ploaness ships, which `build.mjs` generates by inlining the shared
// one. Two files cannot share it, and the shipped one is the file a consumer's `extends` names.
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "references": [
    { "path": "../runtime" },
    { "path": "../governance" },
    { "path": "../config/tsconfig.build.json" }
  ]
}
