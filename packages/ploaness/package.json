{
  "name": "ploaness",
  "version": "1.0.0",
  "description": "An external, versioned quality harness for Payload CMS projects. Declare one dependency and inherit the whole contract.",
  "keywords": [
    "payload",
    "payloadcms",
    "lint",
    "quality",
    "harness",
    "governance"
  ],
  "license": "MIT",
  "author": "Herman Ciechanowiec <herman@ciechanowiec.eu>",
  "type": "module",
  "exports": {
    "./eslint": {
      "types": "./dist/eslint.d.ts",
      "default": "./dist/eslint.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "default": "./dist/vitest.js"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "default": "./dist/playwright.js"
    },
    "./a11y": {
      "types": "./dist/a11y.d.ts",
      "default": "./dist/a11y.js"
    },
    "./access": {
      "types": "./dist/access.d.ts",
      "default": "./dist/access.js"
    },
    "./biome": "./biome.json",
    "./tsconfig": "./tsconfig.json",
    "./package.json": "./package.json",
    "./tsconfig.json": "./tsconfig.json",
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    }
  },
  "bin": {
    "ploaness": "./dist/bin.js"
  },
  "files": [
    "dist",
    "biome.json",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "node build.ts && tsc --build tsconfig.build.json"
  },
  "dependencies": {
    "@ploaness/assets": "1.0.0",
    "@ploaness/cli": "1.0.0",
    "@ploaness/config": "1.0.0",
    "@ploaness/governance": "1.0.0"
  },
  "engines": {
    "node": ">=26"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "typescript": "6.0.3"
  }
}
