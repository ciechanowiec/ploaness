{
  "name": "ploaness",
  "version": "1.0.0",
  "description": "An external, versioned quality harness for Payload CMS projects. Declare one dependency and inherit the whole contract.",
  "keywords": [
    "payload",
    "payloadcms",
    "lint",
    "quality",
    "harness",
    "governance"
  ],
  "license": "MIT",
  "author": "Herman Ciechanowiec <herman@ciechanowiec.eu>",
  "type": "module",
  "exports": {
    "./eslint": {
      "types": "./eslint.d.ts",
      "default": "./eslint.js"
    },
    "./vitest": {
      "types": "./vitest.d.ts",
      "default": "./vitest.js"
    },
    "./biome": "./biome.json",
    "./tsconfig": "./tsconfig.json",
    "./package.json": "./package.json",
    "./tsconfig.json": "./tsconfig.json"
  },
  "bin": {
    "ploaness": "./bin.js"
  },
  "files": [
    "bin.js",
    "biome.json",
    "eslint.d.ts",
    "eslint.js",
    "tsconfig.json",
    "vitest.d.ts",
    "vitest.js"
  ],
  "scripts": {
    "build": "node build.mjs"
  },
  "dependencies": {
    "@ploaness/assets": "1.0.0",
    "@ploaness/cli": "1.0.0",
    "@ploaness/config": "1.0.0",
    "@ploaness/governance": "1.0.0"
  },
  "engines": {
    "node": ">=26"
  },
  "publishConfig": {
    "access": "public"
  }
}
