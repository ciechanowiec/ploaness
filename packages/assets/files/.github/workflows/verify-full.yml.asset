# Full verification: every gate, and the browser sweep over every route and story in Chromium, Firefox
# and WebKit. Pull requests run `pnpm run verify:delta`, which sweeps only the pages a change reaches;
# this run is what makes that safe, so it runs on the default branch every night and on the commit of
# each release tag. `ploaness init` wrote this file once and it is the project's from now on: give the
# job the services and environment the application needs, as the pull-request workflow does.
name: verify-full

on:
  schedule:
    - cron: '17 2 * * *'
  push:
    tags: ['v*']
  workflow_dispatch:

permissions:
  contents: read

jobs:
  verify-full:
    runs-on: ubuntu-latest
    timeout-minutes: 360
    steps:
      - uses: actions/checkout@v6
        with:
          fetch-depth: 0
      - uses: pnpm/action-setup@v4
      - uses: actions/setup-node@v6
        with:
          node-version-file: .nvmrc
          cache: pnpm
      - run: pnpm install --frozen-lockfile
      # The sweep measures in the Playwright image matching the resolved Playwright and never pulls it.
      - run: docker pull "mcr.microsoft.com/playwright:v$(pnpm exec playwright --version | cut -d ' ' -f 2)-noble"
      - run: pnpm run verify:full
