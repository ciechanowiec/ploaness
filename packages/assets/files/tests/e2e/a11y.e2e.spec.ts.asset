// ploaness owns this file. Edit the harness, not this copy: `ploaness verify` compares it byte for byte
// and `ploaness sync` restores it. What a project declares about it goes under the `ploaness` key of
// package.json: route prefixes the crawl must not follow (`accessibilitySkipRoutes`), a smaller route
// ceiling (`accessibilityRouteBudget`), a larger gap between boxes (`layoutMinimumGap`), viewports to
// measure beside the baseline (`layoutViewports`), and the instant the clocks start at (`clock`).
//
// The browser sweep discovers what to scan from the running application - every route reachable from
// the home page, its `hreflang` alternates and its `sitemap.xml`, every story an auxiliary Storybook
// serves, every breakpoint and colour scheme its stylesheets declare - and judges each one by the same
// rules a project's own specs reach through `expectSweptPage`. A page, story, breakpoint or locale is
// therefore checked the moment it exists, with no test to add.
//
// One test per pass, run in order. Discovery writes what it found for the passes after it; each pass
// has its own budget, derived from the work discovery found, and reports every defect it finds rather
// than stopping at the first; the summary judges the exemptions no pass used and prints what was
// covered. Under `ploaness verify` the sweep also runs in Firefox and WebKit, where the engine pass
// covers one route per template and every story.
import { test } from '@playwright/test'
import {
  expectDarkScheme,
  expectDisclosureStates,
  expectDiscoveredSite,
  expectEngineRules,
  expectInteractionStates,
  expectRestingRules,
  expectSweepSummary,
  expectTextStress,
  expectWidthSweep,
} from 'ploaness/sweep'

test.describe('Ploaness browser sweep', () => {
  test('discovers every route, story, breakpoint and colour scheme', async ({ page }) => {
    await expectDiscoveredSite(page)
  })

  test('every page passes the resting rules at every viewport', async ({ page }) => {
    await expectRestingRules(page)
  })

  test('every control passes in hover and keyboard focus', async ({ page }) => {
    await expectInteractionStates(page)
  })

  test('every disclosure passes open and answers the keyboard', async ({ page }) => {
    await expectDisclosureStates(page)
  })

  test('text survives WCAG spacing and doubled size', async ({ page }) => {
    await expectTextStress(page)
  })

  test('layout holds across the whole width range', async ({ page }) => {
    await expectWidthSweep(page)
  })

  test('every page passes in its dark scheme', async ({ page }) => {
    await expectDarkScheme(page)
  })

  test('every sampled page passes in this engine', async ({ page }) => {
    await expectEngineRules(page)
  })

  test('every exemption excuses something, and every pass finished', async ({ page }) => {
    await expectSweepSummary(page)
  })
})
