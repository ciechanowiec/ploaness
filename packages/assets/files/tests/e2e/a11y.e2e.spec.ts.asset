// ploaness owns this file. Edit the harness, not this copy: `ploaness verify` compares it byte for byte
// and `ploaness sync` restores it. What a project declares about it goes under the `ploaness` key of
// package.json: route prefixes the crawl must not follow (`accessibilitySkipRoutes`), a smaller route
// ceiling (`accessibilityRouteBudget`), a larger gap between boxes (`layoutMinimumGap`), viewports to
// measure beside the baseline (`layoutViewports`), and the instant the clocks start at (`clock`).
//
// The browser sweep discovers what to scan from the running application - every route reachable from
// the home page, its `hreflang` alternates and its `sitemap.xml`, every story an auxiliary Storybook
// serves, every breakpoint and colour scheme its stylesheets declare - and judges each one by the same
// rules a project's own specs reach through `expectSweptPage`. A page, story, breakpoint or locale is
// therefore checked the moment it exists, with no test to add.
//
// Discovery runs first, once, in Chromium, and writes what it found for every pass; its problems
// are recorded rather than failing it, because every pass depends on it. Each pass is split into
// shards, one test each, and the shards run on parallel workers while the project's own specs keep to
// one. Each shard has its own budget, derived from the work discovery found, and reports every defect
// it finds rather than stopping at the first. The summary runs last, whatever failed before it: it
// judges discovery's problems and the exemptions no pass used, reports a shard that did not finish,
// and prints what was covered. Under `ploaness verify` the sweep also runs in Firefox and WebKit, where
// the engine pass covers one route per template and one story per component.
import { type Page, test } from '@playwright/test'
import {
  expectDarkScheme,
  expectDisclosureStates,
  expectDiscoveredSite,
  expectEngineRules,
  expectInteractionStates,
  expectRestingRules,
  expectSweepSummary,
  expectTextStress,
  expectWidthSweep,
  type Shard,
  SWEEP_SHARDS,
} from 'ploaness/sweep'

type ShardedPass = (page: Page, shard: Shard) => Promise<void>

interface PassTest {
  readonly title: string
  readonly tag: string
  readonly run: ShardedPass
}

const PASSES: readonly PassTest[] = [
  {
    title: 'every page passes the resting rules at every viewport',
    tag: '@ploaness-chromium',
    run: expectRestingRules,
  },
  {
    title: 'every control passes in hover and keyboard focus',
    tag: '@ploaness-chromium',
    run: expectInteractionStates,
  },
  {
    title: 'every disclosure passes open and answers the keyboard',
    tag: '@ploaness-chromium',
    run: expectDisclosureStates,
  },
  { title: 'text survives WCAG spacing and doubled size', tag: '@ploaness-chromium', run: expectTextStress },
  { title: 'layout holds across the whole width range', tag: '@ploaness-chromium', run: expectWidthSweep },
  { title: 'every page passes in its dark scheme', tag: '@ploaness-chromium', run: expectDarkScheme },
  { title: 'every sampled page passes in this engine', tag: '@ploaness-engine', run: expectEngineRules },
]

const SHARDS: readonly Shard[] = Array.from(
  { length: SWEEP_SHARDS },
  (_unused: unknown, index: number): Shard => ({
    index,
    count: SWEEP_SHARDS,
  }),
)

const DISCOVERY_TITLE: string = 'discovers every route, story, breakpoint and colour scheme'

const partTitle = (pass: PassTest, shard: Shard): string =>
  `${pass.title} (part ${String(shard.index + 1)} of ${String(shard.count)})`

test.describe('Ploaness browser sweep', () => {
  test(DISCOVERY_TITLE, { tag: '@ploaness-discovery' }, async ({ page }) => {
    await expectDiscoveredSite(page)
  })

  for (const pass of PASSES) {
    for (const shard of SHARDS) {
      test(partTitle(pass, shard), { tag: pass.tag }, async ({ page }) => {
        await pass.run(page, shard)
      })
    }
  }

  test('every exemption excuses something, and every pass finished', { tag: '@ploaness-summary' }, async () => {
    await expectSweepSummary()
  })
})
