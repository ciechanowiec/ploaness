{
  "name": "@ploaness/cli",
  "version": "1.0.0",
  "description": "The executable half of ploaness: the verification gates and the commands that run them.",
  "license": "MIT",
  "author": "Herman Ciechanowiec <herman@ciechanowiec.eu>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bin": "./dist/bin.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "ploaness": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@biomejs/biome": "2.5.10",
    "@ploaness/assets": "1.0.0",
    "@ploaness/config": "1.0.0",
    "@ploaness/governance": "1.0.0",
    "@vitest/coverage-v8": "4.1.11",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.9.1",
    "knip": "6.32.3",
    "stylelint": "17.14.1",
    "tsx": "4.23.12",
    "type-coverage": "2.30.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=26"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "26.4.0"
  }
}
