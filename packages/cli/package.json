{
  "name": "@ploaness/cli",
  "version": "1.4.0",
  "description": "The executable half of ploaness: the verification gates and the commands that run them.",
  "license": "MIT",
  "author": "Herman Ciechanowiec <herman@ciechanowiec.eu>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ciechanowiec/ploaness.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/ciechanowiec/ploaness#readme",
  "bugs": {
    "url": "https://github.com/ciechanowiec/ploaness/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bin": "./dist/bin.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "ploaness": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@biomejs/biome": "2.5.13",
    "@ploaness/assets": "1.4.0",
    "@ploaness/config": "1.4.0",
    "@ploaness/governance": "1.4.0",
    "@vitest/coverage-v8": "5.0.1",
    "dependency-cruiser": "18.3.1",
    "eslint": "10.10.0",
    "knip": "6.35.1",
    "oxlint": "1.83.0",
    "stylelint": "17.15.0",
    "tsx": "4.23.13",
    "type-coverage": "2.30.1",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=26"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "26.4.1"
  }
}
