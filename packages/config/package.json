{
  "name": "@ploaness/config",
  "version": "1.0.0",
  "description": "Analyzer and tool configurations owned by ploaness: ESLint, Biome, TypeScript, Vitest, Stylelint, dependency-cruiser, knip.",
  "license": "MIT",
  "author": "Herman Ciechanowiec <herman@ciechanowiec.eu>",
  "type": "module",
  "exports": {
    "./eslint": {
      "types": "./dist/eslint.d.ts",
      "default": "./dist/eslint.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "default": "./dist/vitest.js"
    },
    "./biome": "./biome.json",
    "./tsconfig": "./tsconfig.json",
    "./stylelint": "./stylelint.json",
    "./dependency-cruiser": "./dependency-cruiser.json",
    "./knip": "./knip.json",
    "./package.json": "./package.json",
    "./eslint-core": {
      "types": "./dist/eslint-core.d.ts",
      "default": "./dist/eslint-core.js"
    },
    "./vitest-core": {
      "types": "./dist/vitest-core.d.ts",
      "default": "./dist/vitest-core.js"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "default": "./dist/playwright.js"
    },
    "./a11y": {
      "types": "./dist/a11y.d.ts",
      "default": "./dist/a11y.js"
    },
    "./access": {
      "types": "./dist/access.d.ts",
      "default": "./dist/access.js"
    },
    "./pins": "./pins.json"
  },
  "files": [
    "dist",
    "biome.json",
    "dependency-cruiser-core.json",
    "dependency-cruiser.json",
    "knip.json",
    "pins.json",
    "stylelint.json",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json"
  },
  "dependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@ploaness/governance": "1.0.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-functional": "10.0.0",
    "eslint-plugin-jsdoc": "64.2.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-regexp": "3.2.0",
    "eslint-plugin-sonarjs": "4.2.0",
    "eslint-plugin-testing-library": "7.16.2",
    "eslint-plugin-unicorn": "73.0.0",
    "fast-check": "4.9.0",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "stylelint-config-standard": "40.0.0",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=26"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "typescript": "6.0.3"
  }
}
