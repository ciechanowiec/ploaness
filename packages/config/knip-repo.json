{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/lib/*.ts", "it/lib/*.ts"],
      "project": ["*.{js,mjs,ts,mts}", "scripts/lib/*.ts", "it/lib/*.ts"],
      "ignoreDependencies": ["@arethetypeswrong/cli", "publint"]
    },
    "packages/cli": {
      "entry": [],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": [
        "@biomejs/biome",
        "@ploaness/assets",
        "@ploaness/config",
        "dependency-cruiser",
        "eslint",
        "tsx",
        "type-coverage"
      ]
    },
    "packages/config": {
      "entry": ["src/*.ts", "test/**/*.spec.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": [
        "@axe-core/playwright",
        "@testing-library/jest-dom",
        "@testing-library/react",
        "@testing-library/user-event",
        "fast-check",
        "stylelint-config-standard"
      ],
      "ignoreUnresolved": ["next"]
    },
    "packages/ploaness": {
      "entry": ["src/*.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@ploaness/assets"],
      "ignoreUnresolved": ["next"]
    },
    "packages/runtime": {
      "entry": ["test/**/*.spec.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/assets": {
      "entry": ["test/**/*.spec.ts"],
      "project": ["test/**/*.ts"]
    },
    "packages/governance": {
      "entry": ["test/**/*.spec.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    }
  }
}
