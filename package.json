{
  "name": "ploaness-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Workspace root for ploaness, the external quality harness for Payload CMS projects",
  "license": "MIT",
  "author": "Herman Ciechanowiec <herman@ciechanowiec.eu>",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build",
    "test": "vitest run --coverage",
    "typecheck": "tsc --build --force && tsc -p tsconfig.lint.json",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write . && eslint . --fix",
    "verify": "sh scripts/verify.sh",
    "pack:local": "sh scripts/pack-local.sh",
    "it": "sh it/verify.sh",
    "verify:fast": "pnpm run build && pnpm run typecheck && pnpm run lint && pnpm run lint:eslint && pnpm run test",
    "lint:eslint": "eslint . --max-warnings=0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.13",
    "@ploaness/config": "workspace:*",
    "@ploaness/governance": "workspace:*",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.10.0",
    "fast-check": "4.10.0",
    "ploaness": "workspace:*",
    "publint": "0.3.24",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=26",
    "pnpm": "11.9.0"
  },
  "packageManager": "pnpm@11.9.0",
  "ploaness": {
    "sourceRoots": [
      "packages",
      "scripts",
      "it"
    ],
    "typographyExclusions": [
      {
        "pattern": "^\\.vale/styles/",
        "reason": "Vale detector definitions, whose content is the character they detect"
      }
    ],
    "javascriptAllowlist": [
      {
        "pattern": "^eslint\\.config\\.mjs$",
        "reason": "ESLint's own flat config, which its loader reads as JavaScript unless jiti is added"
      }
    ]
  }
}
