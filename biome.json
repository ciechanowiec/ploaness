{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "extends": ["./packages/config/biome-core.json"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!**/node_modules", "!packages/assets/files"]
  },
  "overrides": [
    {
      "includes": [".adocent/adocent.schema.json"],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
